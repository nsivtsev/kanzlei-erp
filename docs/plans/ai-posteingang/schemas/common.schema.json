{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "quote": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "verification": {
          "enum": [
            "matched",
            "unverified",
            "missing"
          ]
        }
      },
      "required": [
        "page",
        "quote",
        "verification"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "verification": {
                "const": "missing"
              }
            }
          },
          "then": {
            "properties": {
              "quote": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        }
      ]
    },
    "evidence_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "maxItems": 5
    },
    "text_fact": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "$ref": "common.schema.json#/$defs/evidence_list"
        }
      },
      "required": [
        "value",
        "evidence"
      ],
      "additionalProperties": false
    },
    "date_fact": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "$ref": "common.schema.json#/$defs/evidence_list"
        }
      },
      "required": [
        "value",
        "evidence"
      ],
      "additionalProperties": false
    },
    "date": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "identifier": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "de_steuernummer",
            "de_tax_id",
            "de_vat_id",
            "other"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "jurisdiction": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 140
            },
            {
              "type": "null"
            }
          ]
        },
        "authority": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 140
            },
            {
              "type": "null"
            }
          ]
        },
        "other_type": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 140
            },
            {
              "type": "null"
            }
          ]
        },
        "holder_role": {
          "enum": [
            "addressee",
            "sender",
            "representative",
            "other",
            "unknown"
          ]
        },
        "evidence": {
          "$ref": "common.schema.json#/$defs/evidence_list"
        }
      },
      "required": [
        "type",
        "value",
        "jurisdiction",
        "authority",
        "other_type",
        "holder_role",
        "evidence"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "other"
              }
            }
          },
          "then": {
            "properties": {
              "other_type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 140
              },
              "authority": {
                "type": "string",
                "minLength": 1,
                "maxLength": 140
              }
            }
          }
        }
      ]
    },
    "short_text_fact": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "$ref": "common.schema.json#/$defs/evidence_list"
        }
      },
      "required": [
        "value",
        "evidence"
      ],
      "additionalProperties": false
    }
  }
}
