{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "billing.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "amount": {
      "type": "number",
      "minimum": 0
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "const": "evaluation_only"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "amount": {
            "type": "number",
            "minimum": 0
          },
          "requests": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "case_id",
          "amount",
          "requests"
        ],
        "additionalProperties": false
      },
      "maxItems": 50
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "currency",
    "amount",
    "source",
    "period_start",
    "period_end",
    "scope",
    "cases"
  ],
  "additionalProperties": false
}
