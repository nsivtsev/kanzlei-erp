{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "judgments.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "observations_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gold_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "status": {
            "enum": [
              "pending",
              "adjudicated"
            ]
          },
          "reviewer": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 140
              },
              {
                "type": "null"
              }
            ]
          },
          "adjudicator": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 140
              },
              {
                "type": "null"
              }
            ]
          },
          "disputed": {
            "type": "boolean"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ]
          },
          "matches": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "gold_action_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "proposed_action_index": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "gold_action_id",
                "proposed_action_index"
              ],
              "additionalProperties": false
            },
            "maxItems": 30
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "fact_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 140
                },
                "proposed_pointer": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "correct": {
                  "type": "boolean"
                }
              },
              "required": [
                "fact_id",
                "proposed_pointer",
                "correct"
              ],
              "additionalProperties": false
            },
            "maxItems": 200
          },
          "field_edits": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "actions_edited": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "case_id",
          "status",
          "reviewer",
          "adjudicator",
          "disputed",
          "reason",
          "matches",
          "facts",
          "field_edits",
          "actions_edited"
        ],
        "additionalProperties": false
      },
      "maxItems": 50
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "observations_hash",
    "gold_hash",
    "cases"
  ],
  "additionalProperties": false
}
