{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extraction.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "sender": {
      "$ref": "common.schema.json#/$defs/short_text_fact"
    },
    "document_date": {
      "$ref": "common.schema.json#/$defs/date_fact"
    },
    "letter_type": {
      "$ref": "common.schema.json#/$defs/short_text_fact"
    },
    "summary": {
      "$ref": "common.schema.json#/$defs/text_fact"
    },
    "recipients": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "common.schema.json#/$defs/short_text_fact"
          },
          "address": {
            "$ref": "common.schema.json#/$defs/text_fact"
          },
          "identifiers": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/identifier"
            },
            "maxItems": 20
          }
        },
        "required": [
          "name",
          "address",
          "identifiers"
        ],
        "additionalProperties": false
      },
      "maxItems": 20
    },
    "other_identifiers": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/identifier"
      },
      "maxItems": 20
    },
    "readability": {
      "enum": [
        "readable",
        "partial",
        "unreadable"
      ]
    },
    "action_assessment": {
      "enum": [
        "actions_found",
        "none_found",
        "unknown"
      ]
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 140
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "evidence": {
            "$ref": "common.schema.json#/$defs/evidence_list"
          },
          "deadline": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "explicit_date",
                  "relative",
                  "not_found",
                  "uncertain"
                ]
              },
              "date": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "wording": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "anchor": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "evidence": {
                "$ref": "common.schema.json#/$defs/evidence_list"
              }
            },
            "required": [
              "kind",
              "date",
              "wording",
              "anchor",
              "evidence"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "explicit_date"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "date": {
                      "type": "string",
                      "format": "date"
                    },
                    "wording": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    }
                  }
                },
                "else": {
                  "properties": {
                    "date": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "not_found"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "wording": {
                      "type": "null"
                    },
                    "anchor": {
                      "type": "null"
                    },
                    "evidence": {
                      "maxItems": 0
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "relative",
                        "uncertain"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "wording": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    }
                  }
                }
              }
            ]
          }
        },
        "required": [
          "title",
          "description",
          "evidence",
          "deadline"
        ],
        "additionalProperties": false
      },
      "maxItems": 30
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "enum": [
              "ambiguous_customer",
              "unknown_customer",
              "multiple_customers",
              "poor_scan",
              "uncertain_deadline",
              "prompt_injection",
              "incomplete_text",
              "unknown_receipt_date"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "evidence": {
            "$ref": "common.schema.json#/$defs/evidence_list"
          }
        },
        "required": [
          "code",
          "message",
          "evidence"
        ],
        "additionalProperties": false
      },
      "maxItems": 30
    }
  },
  "required": [
    "schema_version",
    "sender",
    "document_date",
    "letter_type",
    "summary",
    "recipients",
    "other_identifiers",
    "readability",
    "action_assessment",
    "actions",
    "warnings"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action_assessment": {
            "const": "actions_found"
          }
        }
      },
      "then": {
        "properties": {
          "actions": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "actions": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "readability": {
            "const": "unreadable"
          }
        }
      },
      "then": {
        "properties": {
          "action_assessment": {
            "const": "unknown"
          }
        }
      }
    }
  ]
}
