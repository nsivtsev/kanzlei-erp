  {
   "fieldname": "error_code",
   "fieldtype": "Data",
   "label": "Error Code",
   "read_only": 1,
   "no_copy": 1,
   "length": 140
  },
  {
   "fieldname": "ocr_pages_json",
   "fieldtype": "JSON",
   "label": "Ocr Pages Json",
   "read_only": 1,
   "no_copy": 1
  },
  {
   "fieldname": "result_json",
   "fieldtype": "JSON",
   "label": "Result Json",
   "read_only": 1,
   "no_copy": 1
  }
 ],
 "permissions": [
  {
   "role": "Desk User",
   "read": 1
  },
  {
   "role": "Posteingang Operator",
   "read": 1
  }
 ],
