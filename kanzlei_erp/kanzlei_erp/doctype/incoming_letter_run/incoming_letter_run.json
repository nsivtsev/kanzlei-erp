{
 "doctype": "DocType",
 "name": "Incoming Letter Run",
 "module": "Kanzlei ERP",
 "engine": "InnoDB",
 "autoname": "hash",
 "track_changes": 0,
 "field_order": [
  "letter",
  "generation",
  "schema_version",
  "prompt_version",
  "provider",
  "ocr_model",
  "extraction_model",
  "status",
  "queued_at",
  "started_at",
  "finished_at",
  "attempt_count",
  "error_code",
  "ocr_pages_json",
  "result_json"
 ],
 "fields": [
