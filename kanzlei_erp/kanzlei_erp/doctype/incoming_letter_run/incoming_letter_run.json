   "ignore_user_permissions": 1,
   "reqd": 1,
   "search_index": 1
  },
  {
   "fieldname": "generation",
   "fieldtype": "Int",
   "label": "Generation",
   "read_only": 1,
   "no_copy": 1,
   "reqd": 1
  },
  {
