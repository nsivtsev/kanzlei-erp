   "fieldtype": "Data",
   "label": "Schema Version",
   "read_only": 1,
   "no_copy": 1,
   "length": 140,
   "reqd": 1,
   "default": "1.0"
  },
  {
   "fieldname": "prompt_version",
   "fieldtype": "Data",
   "label": "Prompt Version",
   "read_only": 1,
   "no_copy": 1,
   "length": 140,
   "reqd": 1
  },
  {
   "fieldname": "provider",
   "fieldtype": "Select",
   "label": "Provider",
   "read_only": 1,
   "no_copy": 1,
   "reqd": 1,
   "options": "fake\nmistral",
   "default": "fake"
  },
  {
   "fieldname": "ocr_model",
   "fieldtype": "Data",
   "label": "Ocr Model",
   "read_only": 1,
   "no_copy": 1,
   "length": 140
  },
  {
   "fieldname": "extraction_model",
   "fieldtype": "Data",
   "label": "Extraction Model",
   "read_only": 1,
   "no_copy": 1,
   "length": 140
