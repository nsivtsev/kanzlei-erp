+})
+
+it('keeps readable ordinary ancestors navigable without offering them as a destination', async () => {
+  const source = { name: 'file', folder: 'old', write: 1 }
+  const state = moveDestination(() => [source], {
+    detail: async name => ({ name, is_folder: 1, read: 1, upload: name === 'home' ? 1 : 0 }),
+    list: async () => ({ rows: [{ name: 'readonly', is_folder: 1, read: 1, upload: 0 }], has_next: false }),
+  })
+  await state.load('home')
