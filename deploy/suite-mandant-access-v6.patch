@@ -0,0 +1,24 @@
+import { canAct } from '@/apps/drive/utils/actionPolicy'
+import emitter from '@/apps/drive/emitter'
+
+type Crumb = { label: string; name: string; route: unknown; onClick?: () => void; readonly?: boolean }
+/** Build a client trail without relying on the route by which it was opened. */
+export function mandantBreadcrumbs(entity: Record<string, any>): Crumb[] | null {
+  const context = entity.mandant
+  if (!context?.folder) return null
+  const trail: Crumb[] = [
+    { label: __('Mandanten'), name: 'drive-Mandanten', route: { name: 'drive-Mandanten' } },
+    { label: context.customer_name, name: context.folder, readonly: true,
+      route: entity.name === context.folder ? null : { name: 'drive-Folder', params: { entityName: context.folder } } },
+  ]
+  const crumbs = entity.breadcrumbs || []
+  const root = crumbs.findIndex((crumb: any) => crumb.name === context.folder)
+  const children = root >= 0 ? crumbs.slice(root + 1) : entity.name !== context.folder ? [{ name: entity.name, file_name: entity.file_name }] : []
+  children.forEach((child: any) => {
+    const final = child.name === entity.name
+    trail.push({ label: child.file_name, name: child.name,
+      route: final ? null : { name: 'drive-Folder', params: { entityName: child.name } },
+      onClick: final && canAct(entity, 'rename') ? () => emitter.emit('rename') : undefined })
+  })
+  return trail
+}
