+  it('refreshes on focus/visible return without a polling timer and removes listeners on disposal', async () => {
+    const { list, request } = setup(); await flush(); window.dispatchEvent(new Event('focus')); await flush(); expect(request).toHaveBeenCalledTimes(2)
+    document.dispatchEvent(new Event('visibilitychange')); await flush(); expect(request).toHaveBeenCalledTimes(3)
