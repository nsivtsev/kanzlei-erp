+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { subscribeFolderChanges } from './realtimeRefresh'
+
+afterEach(() => vi.useRealTimers())
+describe('permission-aware folder refresh', () => {
+  it('coalesces signals, serializes requests and unsubscribes', async () => {
+    vi.useFakeTimers()
+    let handler: (payload: { folder: string }) => void
+    const socket = { on: vi.fn((_event, cb) => { handler = cb }), off: vi.fn() }
+    let finish: () => void
+    const refresh = vi.fn(() => new Promise<void>(resolve => { finish = resolve }))
+    const stop = subscribeFolderChanges(socket, folder => folder === 'allowed', refresh)
+    handler!({ folder: 'denied' })
+    await vi.advanceTimersByTimeAsync(150)
+    expect(refresh).not.toHaveBeenCalled()
+    handler!({ folder: 'allowed' }); handler!({ folder: 'allowed' })
+    await vi.advanceTimersByTimeAsync(150)
+    expect(refresh).toHaveBeenCalledTimes(1)
+    handler!({ folder: 'allowed' })
+    await vi.advanceTimersByTimeAsync(150)
+    expect(refresh).toHaveBeenCalledTimes(1)
+    finish!(); await vi.advanceTimersByTimeAsync(150)
+    expect(refresh).toHaveBeenCalledTimes(2)
+    stop(); finish!(); await vi.advanceTimersByTimeAsync(150)
+    expect(socket.off).toHaveBeenCalledWith('drive-folder-changed', handler!)
+    expect(refresh).toHaveBeenCalledTimes(2)
+  })
+})
