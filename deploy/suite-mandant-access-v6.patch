diff --git a/frontend/src/apps/drive/utils/moveDestination.ts b/frontend/src/apps/drive/utils/moveDestination.ts
new file mode 100644
index 000000000..ae9a4108d
--- /dev/null
+++ b/frontend/src/apps/drive/utils/moveDestination.ts
@@ -0,0 +1,76 @@
+import { reactive } from 'vue'
+import { canAct, canMoveTo, moveScope } from './actionPolicy'
+type Entity = Record<string, any>
+/** Checked destination navigation. UI success is published only after the write completes. */
+export function moveDestination(sources: () => Entity[], api: any) {
+  let generation = 0
+  const state = reactive({
+    target: null as Entity | null, children: [] as Entity[], loading: false, moving: false, error: '',
+    get canMove() { return !state.loading && !state.moving && canMoveTo(sources(), state.target) },
+    invalidate() { generation++; state.target = null; state.children = []; state.loading = false },
+    async load(name: string) {
+      const current = ++generation
+      state.loading = true
+      state.target = null
+      state.children = []
+      state.error = ''
+      try {
+        const target = await api.detail(name)
+        if (current !== generation) return
+        const scope = target.mandant_policy ? target.mandant_policy.root || undefined : null
+        if (!target.is_folder || scope !== moveScope(sources())) throw new Error('Invalid move destination')
+        if (sources().some(e => e.name === target.name || (target.breadcrumbs || []).some((a: Entity) => a.name === e.name)))
+          throw new Error('Cannot move a folder into itself')
+        state.target = target
+        let start = 0
+        do {
+          const response = await api.list(name, start)
+          if (current !== generation) return
+          const rows = Array.isArray(response) ? response : response.rows
+          state.children.push(...(rows || []).filter((row: Entity) => {
+            const rowScope = row.mandant_policy ? row.mandant_policy.root || undefined : null
+            return row.is_folder && rowScope === moveScope(sources()) && row.read !== 0 && !sources().some(e => e.name === row.name)
+          }))
+          if (!response.has_next || response.next_start == null || response.next_start <= start) break
+          start = response.next_start
+        } while (true)
+      } catch {
+        if (current === generation) { state.error = 'This folder is unavailable or you no longer have access.'; state.target = null }
+      } finally { if (current === generation) state.loading = false }
+    },
+    async createFolder(name: string) {
+      if (!name.trim() || !canAct(state.target, 'create_folder') || state.loading || state.moving) return false
+      const current = generation
+      const parent = state.target!.name
+      try {
+        const target = await api.detail(parent)
+        if (current !== generation || !canAct(target, 'create_folder')) return false
+        const created = await api.create(name.trim(), parent)
+        if (current !== generation) return false
+        await state.load(created.name)
+        return true
+      } catch {
+        if (current === generation) state.error = 'Could not create this folder. Check access and try again.'
+        return false
+      }
+    },
+    async submit() {
+      if (!state.canMove || !state.target) return false
+      const current = generation
+      const name = state.target.name
+      const selected = sources().map(e => e.name)
+      state.moving = true
+      state.error = ''
+      try {
+        const [target, ...entities] = await Promise.all([api.detail(name), ...selected.map(id => api.detail(id))])
+        if (current !== generation || !canMoveTo(entities, target)) throw new Error('Move access changed')
+        await api.move(selected, name)
+        return current === generation
+      } catch {
+        if (current === generation) state.error = 'Could not move these items. Check access and try again.'
+        return false
+      } finally { state.moving = false }
+    },
+  })
+  return state
+}
