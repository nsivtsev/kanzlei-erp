diff --git a/frontend/src/apps/drive/utils/mandanten.ts b/frontend/src/apps/drive/utils/mandanten.ts
new file mode 100644
index 000000000..fb1558ab0
--- /dev/null
+++ b/frontend/src/apps/drive/utils/mandanten.ts
@@ -0,0 +1,82 @@
+import { onScopeDispose, ref, watch, type Ref } from 'vue'
+
+export type MandantRow = {
+  customer: string
+  customer_name: string
+  customer_url: string
+  state: 'ready' | 'missing' | 'unavailable'
+  folder: string | null
+  url: string | null
+  can_create: boolean
+}
+type Page = { rows: MandantRow[]; has_next: boolean; next_start: number | null }
+type Request = (method: string, params: Record<string, unknown>) => Promise<any>
+
+/** Page-owned state: never shared or persisted between users. */
+export function useMandanten(request: Request, user: Ref<string | null>, isStaff: Ref<boolean>) {
+  const rows = ref<MandantRow[]>([]), search = ref(''), loading = ref(false)
+  const error = ref<unknown>(null), actionError = ref<unknown>(null)
+  const hasNext = ref(false), nextStart = ref<number | null>(0), creating = ref<string | null>(null)
+  let generation = 0, sessionEpoch = 0, disposed = false, timer: ReturnType<typeof setTimeout> | undefined
+  const eligible = () => !disposed && !!user.value && isStaff.value
+  function clear() {
+    generation++; rows.value = []; hasNext.value = false; nextStart.value = 0
+    loading.value = false; error.value = null; actionError.value = null
+  }
+  async function load(append = false) {
+    if (!eligible() || (append && (loading.value || !hasNext.value))) return
+    if (timer) { clearTimeout(timer); timer = undefined }
+    if (!append) clear()
+    const ticket = ++generation, sessionUser = user.value
+    loading.value = true; error.value = null
+    const valid = () => ticket === generation && eligible() && user.value === sessionUser
+    try {
+      const page: Page = await request('list_mandanten', { search: search.value.trim(), start: append ? nextStart.value : 0, page_length: 50 })
+      if (!valid()) return
+      const combined = append ? [...rows.value, ...page.rows] : page.rows
+      rows.value = [...new Map(combined.map(row => [row.customer, row])).values()]
+      hasNext.value = page.has_next; nextStart.value = page.next_start
+    } catch (failure) {
+      if (!valid()) return
+      // An old list is not evidence that these clients remain readable.
+      rows.value = []; hasNext.value = false; nextStart.value = 0; error.value = failure
+    } finally { if (valid()) loading.value = false }
+  }
+  const refresh = () => load()
+  async function createFolder(customer: string) {
+    if (!eligible() || creating.value) return null
+    const sessionUser = user.value, epoch = sessionEpoch
+    const valid = () => eligible() && user.value === sessionUser && epoch === sessionEpoch
+    creating.value = customer; actionError.value = null
+    try {
+      const result = await request('create_folder', { customer })
+      return valid() ? result : null
+    } catch (failure) {
+      if (valid()) {
+        await refresh()
+        if (valid()) actionError.value = failure
+      }
+      return null
+    } finally { if (valid()) creating.value = null }
+  }
+  watch([user, isStaff], () => {
+    sessionEpoch++
+    if (timer) clearTimeout(timer)
+    clear(); creating.value = null
+    if (eligible()) void refresh()
+  }, { immediate: true, flush: 'sync' })
+  watch(search, () => {
+    if (timer) clearTimeout(timer)
+    clear()
+    if (eligible()) timer = setTimeout(() => { timer = undefined; void refresh() }, 300)
+  }, { flush: 'sync' })
+  const returnToPage = () => { if (document.visibilityState === 'visible') void refresh() }
+  window.addEventListener('focus', returnToPage)
+  document.addEventListener('visibilitychange', returnToPage)
+  onScopeDispose(() => {
+    disposed = true; if (timer) clearTimeout(timer); clear()
+    window.removeEventListener('focus', returnToPage)
+    document.removeEventListener('visibilitychange', returnToPage)
+  })
+  return { rows, search, loading, error, actionError, hasNext, creating, refresh, loadMore: () => load(true), createFolder }
+}
