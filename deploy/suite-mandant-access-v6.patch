+import { createPinia, setActivePinia } from 'pinia'
+import { reactive } from 'vue'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+vi.mock('frappe-ui', () => ({
+  createResource: (options) => reactive({ data: null, loading: false, fetched: false, error: null, ...options }),
+}))
+vi.mock('@/apps/slides/utils/serviceWorker', () => ({ clearSlidesUserData: vi.fn() }))
+import { useCurrentUser, useSessionStore, userResource } from './session'
+
+beforeEach(() => {
+  setActivePinia(createPinia())
+  useSessionStore().user = 'staff@example.com'
+  userResource.data = null
+  userResource.fetched = true
+  userResource.loading = false
+  userResource.error = null
+})
+
+describe('staff navigation eligibility', () => {
+  it('offers employee navigation from saved System User without System Manager role', () => {
+    userResource.data = { name: 'staff@example.com', user_type: 'System User', roles: ['Employee'] }
+    const user = useCurrentUser()
+    expect(user.isStaff?.value).toBe(true)
+    expect(user.isSystemManager.value).toBe(false)
+    expect(user.systemUser.value).toBe(false)
+  })
+
+  it.each([
+    { name: 'member@example.com', user_type: 'Website User', roles: ['System Manager'] },
+    { name: 'Guest', user_type: 'System User', roles: [] },
+    { name: 'staff@example.com', roles: ['System Manager'] },
+    null,
+  ])('hides employee navigation for an unconfirmed staff profile %j', (profile) => {
+    userResource.data = profile
+    useSessionStore().user = profile?.name === 'Guest' ? null : profile?.name ?? null
+    expect(useCurrentUser().isStaff?.value).toBe(false)
+  })
+
+  it('does not treat a cached offline profile as a confirmed server response', () => {
+    userResource.data = { name: 'staff@example.com', user_type: 'System User', roles: [] }
+    userResource.fetched = false
+    expect(useCurrentUser().isStaff.value).toBe(false)
+  })
+
+  it.each([null, 'Guest'])('hides a cached staff profile without a current logged-in staff session %j', (sessionUser) => {
+    userResource.data = { name: 'staff@example.com', user_type: 'System User', roles: [] }
+    useSessionStore().user = sessionUser
+    expect(useCurrentUser().isStaff.value).toBe(false)
+  })
+
+  it('does not offer staff navigation from a profile belonging to another session user', () => {
+    userResource.data = { name: 'old-user@example.com', user_type: 'System User', roles: [] }
+    expect(useCurrentUser().isStaff.value).toBe(false)
+  })
+
+  it('hides a previously loaded staff profile during refresh and after a failed request', () => {
+    userResource.data = { name: 'staff@example.com', user_type: 'System User', roles: [] }
+    const { isStaff } = useCurrentUser()
+    expect(isStaff?.value).toBe(true)
+    userResource.loading = true
+    expect(isStaff?.value).toBe(false)
+    userResource.loading = false
+    userResource.error = new Error('Network failure')
+    expect(isStaff?.value).toBe(false)
+    userResource.error = null
+    expect(isStaff?.value).toBe(true)
+  })
+})
