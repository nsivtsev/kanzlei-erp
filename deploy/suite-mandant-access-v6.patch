+import { describe, expect, it, vi } from 'vitest'
+import { verifiedEntity } from './verifiedEntity'
+const deferred = () => { let resolve: (v: any) => void; const promise = new Promise(r => resolve = r); return { promise, resolve: (v: any) => resolve(v) } }
+describe('verified entity requests', () => {
+  it('discards late route and session responses and clears write grants during refresh', async () => {
+    const a = deferred(), b = deferred()
+    const request = vi.fn().mockReturnValueOnce(a.promise).mockReturnValueOnce(b.promise)
+    const resource = verifiedEntity(request)
+    const first = resource.fetch({ entity_name: 'old' })
+    expect(resource.data).toBe(null)
+    const second = resource.fetch({ entity_name: 'new' })
+    b.resolve({ name: 'new', upload: 0 }); await second
+    a.resolve({ name: 'old', upload: 1 }); await first
+    expect(resource.data).toEqual({ name: 'new', upload: 0 })
+    resource.invalidate()
+    expect(resource.data).toBe(null)
+  })
+  it('invalidates a pending request even if the same user logs in again', async () => {
+    const late = deferred()
+    const resource = verifiedEntity(() => late.promise)
+    const pending = resource.fetch({ entity_name: 'file' })
+    resource.invalidate()
+    late.resolve({ name: 'file', write: 1 }); await pending
+    expect(resource.data).toBe(null)
+    expect(resource.loading).toBe(false)
+  })
+})
