+import { describe, expect, it, vi } from 'vitest'
+import { moveDestination } from './moveDestination'
+const file = { name: 'file', folder: 'old', write: 1, mandant_policy: { root: 'root', actions: { move: true } } }
+const root = { name: 'root', file_name: 'Client', is_folder: 1, upload: 1, mandant_policy: { root: 'root', actions: { upload: true, create_folder: true } }, breadcrumbs: [{ name: 'root' }] }
+function setup(overrides = {}) {
