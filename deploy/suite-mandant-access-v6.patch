+ { customer: 'C1', customer_name: 'Readable', customer_url: '/desk/customer/C1', state: 'ready', folder: 'root', can_create: false },
+ { customer: 'C2', customer_name: 'Writable', customer_url: '/desk/customer/C2', state: 'missing', folder: null, can_create: true },
+ { customer: 'C3', customer_name: 'Broken', customer_url: '/desk/customer/C3', state: 'unavailable', folder: null, can_create: false },
+]
