+<template>
+  <Navbar />
+  <main class="mx-auto w-full max-w-6xl space-y-5 p-5" :aria-busy="loading">
+    <div class="flex flex-wrap items-center justify-between gap-3">
+      <div>
+        <h1 class="text-2xl font-semibold">{{ __('Mandanten') }}</h1>
+        <p class="mt-1 text-sm text-ink-gray-6">{{ __('Client folders follow your ERP access. Personal folders are in Home.') }}</p>
+      </div>
+      <Button :disabled="!isStaff || loading" @click="refresh">{{ __('Refresh') }}</Button>
+    </div>
+    <template v-if="isStaff">
+      <label class="block max-w-xl text-sm">
+        <span class="mb-1 block">{{ __('Search clients by name or ID') }}</span>
+        <input v-model="search" type="search" class="w-full rounded border border-outline-gray-2 bg-surface-base px-3 py-2 text-ink-gray-9" :placeholder="__('Search clients by name or ID')" />
+      </label>
+      <p v-if="actionError" role="alert" class="text-sm text-ink-red-6">{{ __('Could not create the client folder. The list was refreshed; check its status and try again.') }}</p>
+      <div v-if="error" role="alert" class="space-y-2">
+        <p>{{ __('Could not load clients. Check your access and try again.') }}</p>
+        <Button @click="refresh">{{ __('Retry') }}</Button>
+      </div>
+      <p v-else-if="loading && !rows.length" role="status">{{ __('Loading clients…') }}</p>
+      <p v-else-if="!rows.length" role="status">{{ search.trim() ? __('No clients match this search.') : __('No clients are available to you.') }}</p>
+      <template v-if="rows.length">
+        <div class="overflow-x-auto rounded border border-outline-gray-2">
+          <table class="w-full text-left text-sm">
+            <thead class="bg-surface-gray-1 text-ink-gray-6"><tr>
+              <th scope="col" class="px-4 py-3">{{ __('Client') }}</th>
+              <th scope="col" class="px-4 py-3">{{ __('Drive Folder') }}</th>
+              <th scope="col" class="px-4 py-3">{{ __('Actions') }}</th>
+            </tr></thead>
+            <tbody><tr v-for="row in rows" :key="row.customer" class="border-t border-outline-gray-2 align-top">
+              <td class="px-4 py-3"><div class="font-medium">{{ row.customer_name }}</div><div class="mt-1 text-xs text-ink-gray-5">{{ row.customer }}</div></td>
+              <td class="px-4 py-3">{{ stateLabel(row.state) }}<p v-if="row.state === 'unavailable'" class="mt-1 text-xs text-ink-gray-6">{{ __('Contact an administrator.') }}</p></td>
+              <td class="px-4 py-3"><div class="flex flex-wrap items-center gap-3">
+                <Button v-if="row.state === 'ready'" @click="openFolder(row.folder)">{{ __('Open folder') }}</Button>
+                <Button v-else-if="row.state === 'missing' && row.can_create" :disabled="!!creating" :loading="creating === row.customer" @click="create(row.customer)">{{ __('Create Drive Folder') }}</Button>
+                <a :href="row.customer_url" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">{{ __('Open ERP record') }}</a>
+              </div></td>
+            </tr></tbody>
+          </table>
+        </div>
+        <Button v-if="hasNext" :disabled="loading" :loading="loading" @click="loadMore">{{ __('Show more') }}</Button>
+      </template>
+    </template>
+    <p v-else role="status">{{ __('Please log in as a staff user') }}</p>
+  </main>
+</template>
+<script setup lang="ts">
+import { Button, createResource } from 'frappe-ui'
+import { useRouter } from 'vue-router'
+import Navbar from '@/apps/drive/components/Navbar.vue'
+import { useCurrentUser } from '@/boot/session'
+import { useMandanten } from '@/apps/drive/utils/mandanten'
+const { user, isStaff } = useCurrentUser()
+const router = useRouter()
+const request = (method: string, params: Record<string, unknown>) => createResource({
+  url: `kanzlei_erp.mandant_drive.${method}`, method: method === 'create_folder' ? 'POST' : 'GET',
+}).fetch(params)
+const { rows, search, loading, error, actionError, hasNext, creating, refresh, loadMore, createFolder } = useMandanten(request, user, isStaff)
+const stateLabel = (state: string) => state === 'ready' ? __('Folder available') : state === 'missing' ? __('Folder not created') : __('Folder unavailable')
+const openFolder = (folder: string | null) => { if (folder) void router.push({ name: 'drive-Folder', params: { entityName: folder } }) }
+async function create(customer: string) { const result = await createFolder(customer); if (result?.folder) openFolder(result.folder) }
+</script>
