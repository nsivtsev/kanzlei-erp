+"""Optional application restrictions, applied only to already-readable rows."""
+
+import frappe
+
+
+def add_action_policies(rows):
+    if not rows:
+        return rows
+    for hook in frappe.get_hooks("drive_entity_actions_batch"):
+        policies = frappe.call(hook, entities=rows, user=frappe.session.user) or {}
+        for row in rows:
+            if row["name"] in policies:
+                row["mandant_policy"] = policies[row["name"]]
+    return rows
diff --git a/suite/drive/utils/downloads.py b/suite/drive/utils/downloads.py
new file mode 100644
index 000000000..8630c4bb6
--- /dev/null
+++ b/suite/drive/utils/downloads.py
@@ -0,0 +1,137 @@
+"""Stored-content classification and a complete, permission-checked ZIP manifest."""
+
+from dataclasses import dataclass, field
+from pathlib import PurePosixPath
+
+import frappe
+
+
+DOWNLOAD_FIELDS = ["name", "file_name", "folder", "is_folder", "file_type", "file_url",
+                   "content_doctype", "content_docname", "mime_type", "status",
+                   "modified", "content_hash", "file_size"]
+MANIFEST_VERSION = 2
+
+
+def content_kind(entity):
+    if entity.get("kind") == "virtual":
+        return "virtual"
+    if entity.get("is_folder") or entity.get("file_type") == "Folder":
+        return "folder"
+    if entity.get("file_type") == "Link":
+        return "links"
+    content = entity.get("content_doctype")
+    if (content and content != "File") or (entity.get("content_docname") and not content):
+        return "hosted_content"
+    # Legacy native records must never expose a Writer directory as a blob.
+    if entity.get("mime_type") in ("frappe_doc", "frappe/sheet", "frappe/slides"):
+        return "hosted_content"
+    return "stored" if entity.get("file_url") else "missing"
+
+
+def can_download(entity):
+    return content_kind(entity) == "stored" and entity.get("status") in (None, "Active")
+
+
+def _safe_part(value):
+    value = str(value or "").replace("/", "_").replace("\\", "_")
+    value = "".join(char for char in value if ord(char) >= 32 and char != "\x7f").strip()
+    return value if value not in ("", ".", "..") else "file"
+
+
+@dataclass
+class DownloadSelection:
+    files: list = field(default_factory=list)
+    skipped: list = field(default_factory=list)
+
+    def counts(self):
+        return {reason: sum(item["reason"] == reason for item in self.skipped)
+                for reason in ("hosted_content", "links")}
+
+    def signature(self):
+        # Includes descendants and byte revision, so a changed folder never
+        # reuses yesterday's ZIP just because its selected ID is unchanged.
+        return {"files": [(arc, row.name, row.get("file_url"), str(row.get("modified")),
+                           row.get("content_hash"), row.get("file_size")) for arc, row in self.files],
+                "skipped": self.skipped}
+
+
+def collect_downloads(entity_names):
+    from suite.drive.api.permissions import user_has_permission
+
+    selection = DownloadSelection()
+    seen, used_arcs = set(), set()
+    parents = {}
+
+    def unique_arc(arc, folder=False):
+        path = PurePosixPath(arc)
+        candidate, counter = arc, 1
+        while candidate.casefold() in used_arcs:
+            counter += 1
+            label = f"{path.name} ({counter})" if folder else f"{path.stem} ({counter}){path.suffix}"
+            candidate = str(path.with_name(label))
+        used_arcs.add(candidate.casefold())
+        return candidate
+
+    def visit(row, prefix=""):
+        if row.name in seen:
+            return
+        seen.add(row.name)
+        kind = content_kind(row)
+        arc = prefix + _safe_part(row.file_name)
+        if kind == "folder":
+            # Reserve directories too: a blob called 'reports' must not collide
+            # with 'reports/report.xml' in an otherwise valid ZIP.
+            arc = unique_arc(arc, folder=True)
+            children = frappe.get_all("File", filters={"folder": row.name, "status": "Active"},
+                                      fields=DOWNLOAD_FIELDS, order_by="name")
+            for child in children:
+                if user_has_permission(child.name, "read"):
+                    visit(child, arc + "/")
+        elif kind in ("hosted_content", "links"):
+            selection.skipped.append({"name": row.name, "reason": kind})
+        elif kind == "stored":
+            selection.files.append((unique_arc(arc), row))
+        else:
+            frappe.throw("File content is unavailable. Please contact your administrator.", frappe.DoesNotExistError)
+
+    rows = []
+    for name in sorted(set(entity_names)):
+        if not user_has_permission(name, "read"):
+            raise frappe.PermissionError("You do not have permission to download this file")
+        row = frappe.get_value("File", name, DOWNLOAD_FIELDS, as_dict=True)
+        if row and row.status == "Active":
+            rows.append(row)
+            parents[name] = row.get("folder")
+    selected_folders = {row.name for row in rows if content_kind(row) == "folder"}
+
+    def selected_ancestor_count(row):
+        parent, visited, count = row.get("folder"), set(), 0
+        while parent and parent not in visited:
+            if parent in selected_folders:
+                count += 1
+            visited.add(parent)
+            if parent not in parents:
+                parents[parent] = frappe.db.get_value("File", parent, "folder")
+            parent = parents[parent]
+        return count
+
+    # Visit selected ancestors first to preserve the tree. An explicitly
+    # selected child is only deduplicated if traversal actually reached it;
+    # it may be independently readable behind a denied intermediate folder.
+    rows.sort(key=lambda row: (content_kind(row) != "folder", selected_ancestor_count(row), row.name))
+    for row in rows:
+        visit(row)
+    return selection
+
+
+def visible_skipped_counts(entry):
+    from suite.drive.api.permissions import user_has_permission
+
+    counts = {"hosted_content": 0, "links": 0}
+    for item in entry.get("skipped", []):
+        row = frappe.db.get_value("File", item["name"], DOWNLOAD_FIELDS, as_dict=True)
+        if row and row.status == "Active" and user_has_permission(row.name, "read"):
+            kind = content_kind(row)
+            if kind == item["reason"] and kind in counts:
+                counts[kind] += 1
+    return counts
