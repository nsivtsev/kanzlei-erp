--- /dev/null
+++ b/frontend/src/apps/drive/utils/verifiedEntity.ts
@@ -0,0 +1,28 @@
+import { reactive } from 'vue'
+/** A refresh revokes the old UI grant immediately. Only the newest response may publish. */
+export function verifiedEntity(request: (params: any) => Promise<any>, options: any = {}) {
+  let generation = 0
+  const resource = reactive({
+    data: null as any, error: null as any, loading: false, params: {} as any,
+    invalidate() { generation++; resource.data = null; resource.error = null; resource.loading = false },
+    async fetch(params = resource.params) {
+      const current = ++generation
+      resource.params = params
+      resource.data = null
+      resource.error = null
+      resource.loading = true
+      try {
+        const response = await request(params)
+        if (current !== generation) return
+        resource.data = options.transform ? options.transform(response) : response
+        options.onSuccess?.(resource.data)
+        return resource.data
+      } catch (error) {
+        if (current === generation) resource.error = error
+      } finally {
+        if (current === generation) resource.loading = false
+      }
+    },
+  })
+  return resource
+}
