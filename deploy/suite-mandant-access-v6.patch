@@ -0,0 +1,44 @@
+import { describe, expect, it } from 'vitest'
+import { canAct, canActSelection, canMoveTo, moveScope, resolveDragged } from './actionPolicy'
+const ordinary = (name = 'file') => ({ name, read: 1, write: 1, upload: 1, share: 1, kind: 'native', status: 'Active' })
+const managed = (name = 'file', root = 'client-a', isRoot = false) => ({ ...ordinary(name),
+  mandant_policy: { root, is_root: isRoot, actions: { rename: !isRoot, move: !isRoot, trash: !isRoot,
+    share: false, create_native: false, upload: true, create_folder: true, create_link: true } } })
+describe('Drive action policy', () => {
+  it('intersects ordinary permissions and server restrictions without disabling root uploads', () => {
+    const root = { ...managed('client-a', 'client-a', true), is_folder: 1 }
+    expect(canAct(root, 'rename')).toBe(false)
+    expect(canAct(root, 'trash')).toBe(false)
+    expect(canAct(root, 'upload')).toBe(true)
+    expect(canAct(root, 'share')).toBe(false)
+    expect(canAct(root, 'create_native')).toBe(false)
+    expect(canAct({ ...managed(), write: 0 }, 'move')).toBe(false)
+    expect(canAct(ordinary(), 'rename')).toBe(true)
+    expect(canAct(null, 'upload')).toBe(false)
+  })
+  it('fails closed for incomplete policies and mixed selections', () => {
+    expect(canAct({ ...managed(), mandant_policy: { root: null, actions: {} } }, 'move')).toBe(false)
+    expect(canActSelection([managed(), ordinary('b')], 'move')).toBe(false)
+    expect(canActSelection([managed(), managed('b', 'client-b')], 'move')).toBe(false)
+    expect(canActSelection([managed(), managed('b', 'client-a', true)], 'trash')).toBe(false)
+    expect(canActSelection([], 'trash')).toBe(false)
+    expect(moveScope([managed(), managed('b')])).toBe('client-a')
+    expect(moveScope([ordinary()])).toBe(null)
+  })
+  it('allows only same-domain writable destinations, excluding self and descendants', () => {
+    const sources = [{ ...managed('folder'), is_folder: 1, folder: 'parent' }]
+    const root = { ...managed('client-a', 'client-a', true), is_folder: 1 }
+    expect(canMoveTo(sources, root)).toBe(true)
+    expect(canMoveTo(sources, { ...ordinary('home'), is_folder: 1 })).toBe(false)
+    expect(canMoveTo([ordinary()], root)).toBe(false)
+    expect(canMoveTo(sources, { ...root, upload: 0 })).toBe(false)
+    expect(canMoveTo(sources, { ...managed('folder'), is_folder: 1 })).toBe(false)
+    expect(canMoveTo(sources, { ...managed('child'), is_folder: 1, breadcrumbs: [{ name: 'folder' }] })).toBe(false)
+    expect(canMoveTo(sources, { ...managed('parent'), is_folder: 1 })).toBe(false)
+  })
+  it('rejects unknown drag payloads rather than silently moving a subset', () => {
+    expect(resolveDragged(['file', 'unknown'], [managed()])).toEqual([])
+    expect(resolveDragged(['file'], [managed()])).toHaveLength(1)
+    expect(resolveDragged('file', [managed()])).toEqual([])
+  })
+})
diff --git a/frontend/src/apps/drive/utils/actionPolicy.ts b/frontend/src/apps/drive/utils/actionPolicy.ts
new file mode 100644
index 000000000..29487bcf7
--- /dev/null
+++ b/frontend/src/apps/drive/utils/actionPolicy.ts
@@ -0,0 +1,34 @@
+/** UI restrictions intersect existing access; the server still authorizes every write. */
+type Entity = Record<string, any>
+export function canAct(entity: Entity | null | undefined, action: string): boolean {
+  if (!entity || entity._actions_pending || entity.read === 0) return false
+  const policy = entity.mandant_policy
+  if (policy && (!policy.root || policy.actions?.[action] !== true)) return false
+  const access = ['upload', 'create_folder', 'create_link', 'create_native'].includes(action)
+    ? entity.upload : action === 'share' ? entity.share : entity.write
+  if (!access || entity.external || ['virtual', 'attachment'].includes(entity.kind)) return false
+  if (['restore', 'delete'].includes(action)) return !entity.status || entity.status === 'Trashed'
+  return !entity.status || entity.status === 'Active'
+}
+/** undefined means mixed/invalid, null means ordinary Drive. */
+export function moveScope(entities: Entity[]): string | null | undefined {
+  if (!entities.length) return undefined
+  const scopes = entities.map(e => e.mandant_policy ? e.mandant_policy.root || undefined : null)
+  return scopes[0] !== undefined && scopes.every(scope => scope === scopes[0]) ? scopes[0] : undefined
+}
+export function canActSelection(entities: Entity[], action: string): boolean {
+  return !!entities.length && entities.every(e => canAct(e, action)) &&
+    (action !== 'move' || moveScope(entities) !== undefined)
+}
+export function canMoveTo(entities: Entity[], target: Entity | null | undefined): boolean {
+  if (!canActSelection(entities, 'move') || !target?.is_folder || !canAct(target, 'upload')) return false
+  const targetScope = target.mandant_policy ? target.mandant_policy.root || undefined : null
+  if (moveScope(entities) !== targetScope) return false
+  const ancestors = new Set((target.breadcrumbs || []).map((e: Entity) => e.name))
+  return entities.every(e => e.name !== target.name && !ancestors.has(e.name) && e.folder !== target.name)
+}
+export function resolveDragged(names: unknown, rows: Entity[]): Entity[] {
+  if (!Array.isArray(names) || !names.length || names.some(n => typeof n !== 'string')) return []
+  const resolved = [...new Set(names)].map(name => rows.find(e => e.name === name))
+  return resolved.every(Boolean) ? resolved as Entity[] : []
+}
