+    mocks.request.mockImplementation(async ({ url, params }) => url.endsWith('list.files') ? { rows: [], has_next: false } : { ...folder(params.entity_name), mandant_policy: policy })
+    const { app, container } = mount([{ name: 'file', folder: 'old', write: 1, mandant_policy: policy }]); await tick()
+    expect([...container.querySelectorAll('button')].map(b => b.textContent)).not.toContain('Site')
+    mocks.session.isLoggedIn = false; await tick()
+    const move = [...container.querySelectorAll('button')].find(b => b.textContent === 'Move')
+    expect(move?.disabled ?? true).toBe(true)
+    app.unmount()
+  })
+})
