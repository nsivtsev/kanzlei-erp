+}
+it('checks upload access after returning from the OS picker while folder context refreshes', async () => {
+  const app = mount()
+  mocks.handlers.uploadFile()
+  mocks.folder.value.entity = null
+  const done = vi.fn()
+  await mocks.zone.options.accept({ size: 10, parent: 'folder' }, done)
+  expect(mocks.request).toHaveBeenCalled()
+  expect(done).toHaveBeenCalledWith()
+  app.unmount()
+})
+it('refuses upload when the fresh server check denies access', async () => {
+  const app = mount()
+  mocks.request.mockResolvedValue({ name: 'folder', is_folder: 1, upload: 0 })
+  const done = vi.fn()
+  await mocks.zone.options.accept({ size: 10, parent: 'folder' }, done)
+  expect(done).toHaveBeenCalledWith(expect.any(String))
+  app.unmount()
+})
+
+it('discards a pending upload authorization when the session changes', async () => {
+  const app = mount()
+  let finish: (value: any) => void
+  mocks.request.mockImplementation(() => new Promise(resolve => finish = resolve))
+  const done = vi.fn()
+  const pending = mocks.zone.options.accept({ size: 10, parent: 'folder' }, done)
+  mocks.session.isLoggedIn = false
+  finish!({ name: 'folder', is_folder: 1, upload: 1 })
+  await pending
+  expect(done).toHaveBeenCalledWith(expect.any(String))
+  app.unmount()
+})
+
+it('re-accepts a previously denied file before retrying after access is restored', async () => {
