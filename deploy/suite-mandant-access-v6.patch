+  it('excludes managed foreign/ordinary destinations and moved source folders', async () => {
+    const { state } = setup({ list: vi.fn(async () => ({ rows: [
+      { ...root, name: 'allowed' }, { ...root, name: 'file' },
+      { ...root, name: 'foreign', mandant_policy: { root: 'other', actions: { upload: true } } },
+      { name: 'ordinary', is_folder: 1, upload: 1 }], has_next: false })) })
+    await state.load('root')
+    expect(state.children.map(e => e.name)).toEqual(['allowed'])
+  })
+  it('rechecks both source and target before moving and does not send a stale grant', async () => {
+    const { state, api } = setup()
