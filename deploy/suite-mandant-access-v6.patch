@@ -0,0 +1,31 @@
+import { onBeforeUnmount, watch } from 'vue'
+import { frappeRequest } from 'frappe-ui'
+import { useSessionStore } from '@/boot/session'
+import emitter from '@/apps/drive/emitter'
+import { verifiedEntity } from './verifiedEntity'
+/** Single source for entity-page grants, including route/session/focus refresh. */
+export function useVerifiedEntity(options: any = {}) {
+  const session = useSessionStore()
+  const resource = verifiedEntity(async params => {
+    const response = await frappeRequest({ url: '/api/method/suite.drive.api.permissions.get_entity_with_permissions',
+      method: 'GET', params })
+    return response?.message ?? response
+  }, options)
+  const refresh = () => {
+    if (document.visibilityState === 'hidden' || !resource.params.entity_name) return
+    resource.fetch()
+    emitter.emit('refresh')
+  }
+  watch(() => [session.user, session.isLoggedIn], () => {
+    resource.invalidate()
+    if (resource.params.entity_name) refresh()
+  }, { flush: 'sync' })
+  window.addEventListener('focus', refresh)
+  document.addEventListener('visibilitychange', refresh)
+  onBeforeUnmount(() => {
+    resource.invalidate()
+    window.removeEventListener('focus', refresh)
+    document.removeEventListener('visibilitychange', refresh)
+  })
+  return resource
+}
