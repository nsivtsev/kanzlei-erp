+  return { list, request, user, isStaff }
+}
+const flush = async () => { await Promise.resolve(); await Promise.resolve(); await nextTick() }
+function deferred() { let resolve!: (value: any) => void, reject!: (reason: any) => void; const promise = new Promise((a,b) => { resolve = a; reject = b }); return { promise, resolve, reject } }
+
+describe('Mandanten list requests', () => {
+  it('loads only for confirmed staff and clears immediately on session changes', async () => {
+    const { list, request, isStaff, user } = setup(); await flush()
+    expect(list.rows.value).toEqual([row()]); expect(request).toHaveBeenCalledWith('list_mandanten', { search: '', start: 0, page_length: 50 })
+    isStaff.value = false; await flush(); expect(list.rows.value).toEqual([])
+    user.value = null; await flush(); expect(request).toHaveBeenCalledTimes(1)
+  })
+  it('ignores older search responses and debounces for 300ms', async () => {
+    vi.useFakeTimers(); const old = deferred(), newer = deferred()
+    const { list, request } = setup(vi.fn().mockReturnValueOnce(old.promise).mockReturnValueOnce(newer.promise))
+    list.search.value = 'new'; await nextTick(); expect(list.rows.value).toEqual([])
+    await vi.advanceTimersByTimeAsync(299); expect(request).toHaveBeenCalledTimes(1)
+    await vi.advanceTimersByTimeAsync(1); newer.resolve(page('new')); await flush()
+    old.resolve(page('old')); await flush(); expect(list.rows.value[0].customer).toBe('new')
+  })
+  it('ignores responses from a previous user even after a new session starts', async () => {
+    const old = deferred(); const { list, user, request } = setup(vi.fn().mockReturnValueOnce(old.promise).mockResolvedValue(page('new')))
+    user.value = 'next'; await flush(); old.resolve(page('old')); await flush()
+    expect(request).toHaveBeenCalledTimes(2); expect(list.rows.value[0].customer).toBe('new')
+  })
+  it('appends pages using the server continuation then refreshes from zero', async () => {
