+    api.detail.mockResolvedValue({ ...file, write: 0 })
+    expect(await state.submit()).toBe(false)
+    expect(api.move).not.toHaveBeenCalled()
+  })
+  it('ignores late destinations after invalidation', async () => {
+    let resolve: (v: any) => void
+    const { state } = setup({ detail: vi.fn(() => new Promise(r => resolve = r)) })
+    const pending = state.load('root')
