+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+const mocks = vi.hoisted(() => ({ fetch: vi.fn() }))
+vi.mock('frappe-ui', () => ({
+  createResource: (options) => ({
+    fetch: () => mocks.fetch(options).then((data) => options.transform(data)),
+  }),
+}))
+vi.mock('@/apps/drive/data/selection', () => ({ setActiveEntity: vi.fn() }))
+vi.mock('@/utils/setupTheme', () => ({ setupTheme: vi.fn() }))
+import { bootstrap } from './runtime'
+
+const fetcher = mocks.fetch
+beforeEach(() => {
+  delete window.translatedMessages
+  fetcher.mockReset()
+})
+afterEach(() => {
+  vi.restoreAllMocks()
+})
+
+describe('Drive translation readiness', () => {
+  it.each([
+    { 'Back to Kanzlei': 'Zur Kanzlei' },
+    { 'Back to Kanzlei': 'В Kanzlei' },
+  ])('waits for translations before the router can mount its sidebar %j', async (translations) => {
+    let finish!: (data: typeof translations) => void
+    fetcher.mockImplementation(() => new Promise((resolve) => { finish = resolve }))
+    let ready = false
+    const boot = Promise.resolve(bootstrap()).then(() => { ready = true })
+    await Promise.resolve()
+    expect(ready).toBe(false)
+    expect(fetcher).toHaveBeenCalledWith(expect.objectContaining({ url: 'suite.drive.api.product.get_translations' }))
+    finish(translations)
+    await boot
+    expect(window.translatedMessages).toEqual(translations)
+    expect(ready).toBe(true)
+  })
+
+  it('keeps Drive startup available with source labels when translation loading fails', async () => {
+    fetcher.mockRejectedValue(new Error('Translation service unavailable'))
+    vi.spyOn(console, 'warn').mockImplementation(() => {})
+    await expect(bootstrap()).resolves.toBeUndefined()
+    expect(window.translatedMessages).toBeUndefined()
+  })
+
+  it('reuses an already loaded translation dictionary without another request', async () => {
+    window.translatedMessages = { 'Back to Kanzlei': 'Zur Kanzlei' }
+    await bootstrap()
+    expect(fetcher).not.toHaveBeenCalled()
+    expect(window.translatedMessages['Back to Kanzlei']).toBe('Zur Kanzlei')
+  })
+})
