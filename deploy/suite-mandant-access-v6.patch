+export function canDownloadEntity(entity) {
+  return entity?.kind !== 'virtual' && !!(entity?.is_folder || entity?.can_download)
+}
+
+// Hosted documents and links remain in mixed selections so the archive API
+// can report their omission. Virtual attachment buckets are not File IDs.
+export function canDownloadSelection(entities) {
+  return entities.length > 0 &&
+    entities.every((entity) => entity?.kind !== 'virtual') &&
+    entities.some(canDownloadEntity)
+}
