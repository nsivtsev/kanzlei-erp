+import MoveDialog from './MoveDialog.vue'
+const tick = async () => { for (let i = 0; i < 12; i++) await nextTick() }
+const folder = name => ({ name, file_name: name, is_folder: 1, read: 1, upload: 1, write: 1, breadcrumbs: [{ name, file_name: name }] })
+function mount(entities) {
+  const container = document.createElement('div')
+  const success = vi.fn()
+  const app = createApp({ render: () => h(MoveDialog, { entities, onSuccess: success }) })
+  app.config.globalProperties.__ = text => text
+  app.mount(container)
+  return { app, container, success }
+}
+beforeEach(() => {
+  window.__ = text => text
+  sessionStorage.clear()
+  mocks.session = reactive({ user: 'employee', isLoggedIn: true })
+  mocks.request.mockReset().mockImplementation(async ({ url, params }) => {
+    if (url.endsWith('list.files')) return { rows: [], has_next: false }
+    return folder(params.entity_name)
+  })
+})
+describe('Move dialog wiring', () => {
+  it('honours explicit Home/Site tabs after restoring a remembered folder', async () => {
+    sessionStorage.setItem('drive:last-move-dest:employee:ordinary', JSON.stringify({ parent: 'remembered' }))
+    const { app, container } = mount([{ name: 'file', folder: 'old', write: 1 }])
+    await tick()
+    expect(container.textContent).toContain('remembered')
+    const site = [...container.querySelectorAll('button')].find(b => b.textContent === 'Site')!
+    site.click(); await tick()
+    expect(container.textContent).toContain('Moving to: site')
+    app.unmount()
+  })
+  it('does not remove items or emit success when the server rejects a move', async () => {
+    const source = { name: 'file', folder: 'old', write: 1 }
+    mocks.request.mockImplementation(async ({ url, params }) => {
+      if (url.endsWith('list.files')) return { rows: [], has_next: false }
+      if (url.endsWith('files.move')) throw new Error('Access revoked')
+      return params.entity_name === 'file' ? source : folder(params.entity_name)
+    })
+    const { app, container, success } = mount([source]); await tick()
+    const move = [...container.querySelectorAll('button')].find(b => b.textContent === 'Move')!
+    expect(move.disabled).toBe(false)
+    move.click(); await tick()
+    expect(success).not.toHaveBeenCalled()
+    expect(container.textContent).toContain('Could not move these items')
+    app.unmount()
+  })
+  it('hides ordinary tabs for a Mandant and closes on a session change', async () => {
