+vi.mock('dropzone', async () => {
+  const RealDropzone = (await vi.importActual<any>('dropzone')).default
+  class Dropzone {
+    static forElement() { throw new Error('no existing uploader') }
+    static ERROR = 'error'
+    static ADDED = 'added'
+    static CANCELED = 'canceled'
+    options: any; files = []; hiddenFileInput = document.createElement('input')
+    accept(file, done) { return RealDropzone.prototype.accept.call(this, file, done) }
+    enqueueFile = vi.fn(file => { if (!file.accepted) throw new Error('File has not been accepted'); file.status = 'queued' })
+    processFile = vi.fn()
+    on = vi.fn(); destroy = vi.fn(); removeAllFiles = vi.fn(); removeFile = vi.fn()
+    constructor(_selector, options) { this.options = options; mocks.zone = this }
