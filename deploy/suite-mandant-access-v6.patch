+    await flush(); await list.loadMore(); expect(list.rows.value.map(r => r.customer)).toEqual(['A','B'])
+    expect(request.mock.calls[1][1].start).toBe(1); await list.refresh(); expect(list.rows.value).toEqual([row('C')])
+  })
+  it('clears rows on permission failure and retries the first page', async () => {
+    const { list, request } = setup(); await flush(); request.mockRejectedValueOnce({ exc_type: 'PermissionError' })
+    await list.refresh(); expect(list.rows.value).toEqual([]); expect(list.error.value).toBeTruthy()
+    await list.refresh(); expect(list.rows.value).toEqual([row()]); expect(list.error.value).toBeNull()
+  })
+  it('creates once while pending and returns the existing API folder result', async () => {
+    const create = deferred(); const { list, request } = setup(); await flush()
+    request.mockReturnValueOnce(create.promise)
+    const pending = list.createFolder('A'); await list.createFolder('A')
+    expect(request.mock.calls.filter(call => call[0] === 'create_folder')).toHaveLength(1)
+    create.resolve({ folder: 'root', url: '/drive/d/root' }); expect(await pending).toEqual({ folder: 'root', url: '/drive/d/root' })
+    expect(list.creating.value).toBeNull()
+  })
+  it('ignores a create response after losing and regaining the same staff session', async () => {
+    const create = deferred(); const { list, request, isStaff } = setup(); await flush()
+    request.mockReturnValueOnce(create.promise)
