diff --git a/frontend/src/apps/drive/utils/realtimeRefresh.js b/frontend/src/apps/drive/utils/realtimeRefresh.js
new file mode 100644
index 000000000..85854f1e7
--- /dev/null
+++ b/frontend/src/apps/drive/utils/realtimeRefresh.js
@@ -0,0 +1,28 @@
+// Signals carry only a folder ID. The caller re-fetches through the normal API.
+export function subscribeFolderChanges(socket, accepts, refresh) {
+  let timer, pending = false, running = false, stopped = false
+  const schedule = () => {
+    if (stopped || running || timer) return
+    timer = setTimeout(async () => {
+      timer = undefined
+      if (stopped || !pending) return
+      pending = false
+      running = true
+      try { await refresh() } finally {
+        running = false
+        if (pending) schedule()
+      }
+    }, 150)
+  }
+  const changed = ({ folder } = {}) => {
+    if (stopped || typeof folder !== 'string' || !accepts(folder)) return
+    pending = true
+    schedule()
+  }
+  socket.on('drive-folder-changed', changed)
+  return () => {
+    stopped = true
+    clearTimeout(timer)
+    socket.off('drive-folder-changed', changed)
+  }
+}
diff --git a/frontend/src/apps/drive/utils/realtimeRefresh.test.ts b/frontend/src/apps/drive/utils/realtimeRefresh.test.ts
new file mode 100644
index 000000000..faac34a7d
--- /dev/null
+++ b/frontend/src/apps/drive/utils/realtimeRefresh.test.ts
@@ -0,0 +1,28 @@
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { subscribeFolderChanges } from './realtimeRefresh'
+
+afterEach(() => vi.useRealTimers())
+describe('permission-aware folder refresh', () => {
+  it('coalesces signals, serializes requests and unsubscribes', async () => {
+    vi.useFakeTimers()
+    let handler: (payload: { folder: string }) => void
+    const socket = { on: vi.fn((_event, cb) => { handler = cb }), off: vi.fn() }
+    let finish: () => void
+    const refresh = vi.fn(() => new Promise<void>(resolve => { finish = resolve }))
+    const stop = subscribeFolderChanges(socket, folder => folder === 'allowed', refresh)
+    handler!({ folder: 'denied' })
+    await vi.advanceTimersByTimeAsync(150)
+    expect(refresh).not.toHaveBeenCalled()
+    handler!({ folder: 'allowed' }); handler!({ folder: 'allowed' })
+    await vi.advanceTimersByTimeAsync(150)
+    expect(refresh).toHaveBeenCalledTimes(1)
+    handler!({ folder: 'allowed' })
+    await vi.advanceTimersByTimeAsync(150)
+    expect(refresh).toHaveBeenCalledTimes(1)
+    finish!(); await vi.advanceTimersByTimeAsync(150)
+    expect(refresh).toHaveBeenCalledTimes(2)
+    stop(); finish!(); await vi.advanceTimersByTimeAsync(150)
+    expect(socket.off).toHaveBeenCalledWith('drive-folder-changed', handler!)
+    expect(refresh).toHaveBeenCalledTimes(2)
+  })
+})
