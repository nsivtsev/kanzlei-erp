+def get_app_access(entity, user):
+    """An app may own access to a File; None preserves Suite semantics."""
+    for hook in frappe.get_hooks("drive_entity_access"):
+        access = frappe.call(hook, entity=entity, user=user)
+        if access is not None:
+            return access
+    return None
+
+
+def get_app_access_batch(entities, user):
+    """Batch providers must return only the File IDs whose access they own."""
+    hooks = frappe.get_hooks("drive_entity_access_batch")
+    if not hooks:
+        return {entity.name: access for entity in entities
+                if (access := get_app_access(entity, user)) is not None}
+    result = {}
+    for hook in hooks:
+        for name, access in frappe.call(hook, entities=entities, user=user).items():
+            result.setdefault(name, access)
+    return result
+
+
 def get_user_access_for_user(entity: str | Document | frappe._dict, user: str):
+    app_access = get_app_access(entity, user)
+    if app_access is not None:
+        return app_access
     if isinstance(entity, str):
         entity = frappe.get_cached_doc("File", entity)
 
