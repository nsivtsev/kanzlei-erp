# Copy to /opt/kanzlei-erp/shared/production.env (chmod 600).
# Plain KEY=value entries only; use generated hexadecimal passwords.
DOMAIN=erp.example.com
SITE_NAME=erp.example.com
ACME_EMAIL=ops@example.com
DB_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32
ADMIN_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32
PROJECT_NAME=kanzlei-production
PLATFORM=linux/amd64
FRONTEND_PORT=8080
HTTPS_ENABLED=1

# AI is optional. Enable only after provisioning separate credentials and tested images.
AI_ENABLED=0
# AI_API_IMAGE=registry.example/kanzlei-ai-api@sha256:REPLACE_WITH_64_HEX_DIGEST
# AI_WORKER_IMAGE=registry.example/kanzlei-ai-worker@sha256:REPLACE_WITH_64_HEX_DIGEST
# AI_POSTGRES_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32
# AI_ERP_SERVICE_KEY=REPLACE_WITH_INDEPENDENT_SERVICE_KEY
# AI_API_PORT=8180
# AI_INGESTION_ENABLED=false
# AI_INGESTION_KEY=REPLACE_WITH_DIFFERENT_INGESTION_KEY
