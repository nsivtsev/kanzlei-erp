# Copy to /opt/kanzlei-erp/shared/production.env (chmod 600).
# Plain KEY=value entries only; use generated hexadecimal passwords.
DOMAIN=erp.example.com
SITE_NAME=erp.example.com
ACME_EMAIL=ops@example.com
DB_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32
ADMIN_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32
PROJECT_NAME=kanzlei-production
PLATFORM=linux/amd64
FRONTEND_PORT=8080
HTTPS_ENABLED=1
