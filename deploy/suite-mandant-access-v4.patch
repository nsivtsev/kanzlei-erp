+
+def get_app_access_batch(entities, user):
+    """Batch providers must return only the File IDs whose access they own."""
+    hooks = frappe.get_hooks("drive_entity_access_batch")
+    if not hooks:
+        return {entity.name: access for entity in entities
+                if (access := get_app_access(entity, user)) is not None}
+    result = {}
+    for hook in hooks:
+        for name, access in frappe.call(hook, entities=entities, user=user).items():
+            result.setdefault(name, access)
+    return result
+
