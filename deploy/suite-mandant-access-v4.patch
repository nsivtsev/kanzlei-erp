index 000000000..f5097e107
--- /dev/null
+++ b/frontend/src/apps/drive/utils/navigation.js
@@ -0,0 +1,45 @@
+import slugify from 'slugify'
+
+export function folderRoute(entity) {
+  return entity.kind === 'virtual'
+    ? {
+        name: 'drive-Attachments',
+        params: entity.attached_to_name
+          ? { doctype: entity.attached_to_doctype, docname: entity.attached_to_name }
+          : { doctype: entity.attached_to_doctype },
+      }
+    : { name: 'drive-Folder', params: { entityName: entity.name } }
+}
+
+// Display types describe uploaded bytes too. Only content metadata identifies
+// a hosted editor document; Writer routes by the containing File's ID.
+export function entityRoute(entity) {
+  if (entity.kind === 'virtual') return folderRoute(entity)
+  if (entity.name === '') return { name: 'drive-Home' }
+  if (entity.is_folder) return folderRoute(entity)
+  if (entity.content_doctype === 'Writer Document')
+    return { name: 'writer-document', params: { id: entity.name } }
+  if (entity.content_doctype === 'Sheet')
+    return { name: 'sheets-editor', params: { id: entity.content_docname || entity.name } }
+  if (entity.content_doctype === 'Presentation')
+    return { name: 'slides-editor', params: { presentationId: entity.content_docname } }
+  return { name: 'drive-File', params: { entityName: entity.name } }
+}
+
+export function entityLink(entity, origin) {
+  if (entity.file_type === 'Link') return entity.file_url
+  const route = entityRoute(entity)
+  const id = encodeURIComponent(entity.name)
+  if (route.name === 'writer-document') return `${origin}/writer/w/${id}`
+  if (route.name === 'sheets-editor') return `${origin}/sheets/${encodeURIComponent(route.params.id)}`
+  if (route.name === 'slides-editor') return `${origin}/slides/presentation/${encodeURIComponent(route.params.presentationId)}`
+  if (route.name === 'drive-Home') return `${origin}/drive`
+  if (route.name === 'drive-Attachments') {
+    const doctype = encodeURIComponent(route.params.doctype)
+    return `${origin}/drive/attachments/${doctype}${route.params.docname ? '/' + encodeURIComponent(route.params.docname) : ''}`
+  }
+  const slug = slugify((entity.file_name || '').split('.').join(' '), {
+    lower: true, trim: true, remove: /[^\w\s']/,
+  })
+  return `${origin}/drive/${entity.is_folder ? 'd' : 'f'}/${id}/${slug}`
+}
diff --git a/frontend/src/apps/drive/utils/realtimeRefresh.js b/frontend/src/apps/drive/utils/realtimeRefresh.js
new file mode 100644
index 000000000..85854f1e7
--- /dev/null
+++ b/frontend/src/apps/drive/utils/realtimeRefresh.js
@@ -0,0 +1,28 @@
+// Signals carry only a folder ID. The caller re-fetches through the normal API.
+export function subscribeFolderChanges(socket, accepts, refresh) {
+  let timer, pending = false, running = false, stopped = false
+  const schedule = () => {
+    if (stopped || running || timer) return
+    timer = setTimeout(async () => {
+      timer = undefined
+      if (stopped || !pending) return
+      pending = false
+      running = true
+      try { await refresh() } finally {
+        running = false
+        if (pending) schedule()
+      }
+    }, 150)
+  }
+  const changed = ({ folder } = {}) => {
+    if (stopped || typeof folder !== 'string' || !accepts(folder)) return
+    pending = true
+    schedule()
+  }
+  socket.on('drive-folder-changed', changed)
+  return () => {
+    stopped = true
+    clearTimeout(timer)
+    socket.off('drive-folder-changed', changed)
+  }
+}
