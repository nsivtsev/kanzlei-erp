+import { createApp, defineComponent, h, nextTick } from 'vue'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+const mocks = vi.hoisted(() => ({ fetch: vi.fn() }))
+vi.mock('frappe-ui', () => ({ Button: defineComponent({ setup: (_, { slots }) => () => h('button', slots.default?.()) }) }))
+vi.mock('@/apps/drive/resources/permissions', () => ({ diskSettings: { data: { preview_size: 100 }, fetch: vi.fn() } }))
+vi.mock('./FileTypePreview/TextPreview.vue', () => ({ __esModule: true, default: { template: '<div data-preview="text" />' } }))
+vi.mock('./FileTypePreview/PDFPreview.vue', () => ({ __esModule: true, default: { template: '<div data-preview="pdf" />' } }))
+vi.mock('./FileTypePreview/ImagePreview.vue', () => ({ __esModule: true, default: { template: '<div data-preview="image" />' } }))
+import FileRender from './FileRender.vue'
+beforeEach(() => {
+  mocks.fetch.mockClear()
+  window.fetch = mocks.fetch
+  Object.defineProperty(window, 'location', { configurable: true, value: { href: '', origin: 'http://localhost' } })
+})
+async function mount(previewEntity) {
+  const root = document.createElement('div')
+  const app = createApp({ render: () => h(FileRender, { previewEntity }) })
+  app.mount(root)
+  await new Promise((resolve) => setTimeout(resolve, 30))
+  await nextTick()
+  return { app, root }
+}
+describe('stored file preview', () => {
+  it.each(['Document', 'Spreadsheet', 'Presentation'])('shows a local download card for Office %s', async (file_type) => {
+    const { app, root } = await mount({ name: 'office-1', file_name: 'Report.docx', file_type, file_size: 2500, can_download: true })
+    expect(root.textContent).toContain('Report.docx')
+    expect(root.textContent).toContain(file_type)
+    expect(root.textContent).toContain('2.5 KB')
+    expect(root.textContent).toContain('Preview is not available')
+    expect(root.textContent).not.toContain('Microsoft')
+    expect(root.querySelector('iframe')).toBeNull()
+    expect(mocks.fetch).not.toHaveBeenCalled()
+    root.querySelector('button')!.click()
+    expect(window.location.href).toBe('/api/method/suite.drive.api.files.get_file_content?entity_name=office-1&trigger_download=1')
+    app.unmount()
+  })
+  it('uses CSV MIME to keep its text preview', async () => {
+    const { app, root } = await mount({ name: 'csv-1', file_type: 'Spreadsheet', mime_type: 'text/csv', can_download: true })
+    expect(root.querySelector('[data-preview="text"]')).not.toBeNull()
+    app.unmount()
+  })
+  it.each([['PDF', 'pdf'], ['Image', 'image'], ['Text', 'text']])('preserves the %s preview', async (file_type, preview) => {
+    const { app, root } = await mount({ name: 'file-1', file_type, can_download: true })
+    expect(root.querySelector(`[data-preview="${preview}"]`)).not.toBeNull()
+    app.unmount()
+  })
+  it('does not offer download when the server capability is false', async () => {
+    const { app, root } = await mount({ name: 'file-1', file_type: 'Unknown', can_download: false })
+    expect(root.querySelector('button')).toBeNull()
+    app.unmount()
+  })
+})
